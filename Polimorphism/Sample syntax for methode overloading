import java.util.*;

class Student{
    int add(int a,int b){
        return a+b;
    }
    int add(int a,int b,int c){
        return a+b+c;
    }
}
public class sampleSyntaxMethodeOVerloading{
    public static void main(String[] args){
        Student a=new Student();
        System.out.println(a.add(10,20));
        System.out.println(a.add(10,20,30));
        
    }
}

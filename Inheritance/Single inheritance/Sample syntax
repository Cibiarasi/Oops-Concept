import java.util.*;
class vechile{
    void start(){
        System.out.println("vechile started");
    }
}
class car extends vechile{
    void end(){
        System.out.println("car ended");
    }
}
public class Sample{
    public static void main(String[] args){
        car c=new car();
        c.start();
        c.end();
    }
}
